# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Large raw datasets (HCRL Car-Hacking Dataset)
data/raw/*
!data/raw/.gitkeep

# Processed heavy arrays & splits
data/processed/*.npz
data/splits/*
!data/splits/.gitkeep

# Local scratch and temporary files
scratch/
*.tmp
*.log
